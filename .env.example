# ─── The Sports Digest · environment template ───────────────────────────────
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# Live fixtures from football-data.org (GET /api/matches).
# The route reads API_SPORTS_KEY and falls back to NEXT_PUBLIC_API_KEY.
API_SPORTS_KEY=

# OpenAI key for editorial insight generation (GET /api/insights)
OPENAI_API_KEY=

# Public key exposed to the browser bundle. Keep it read-only.
NEXT_PUBLIC_API_KEY=

# Resend key for the breaking-news bulletin (POST /api/newsletter/breaking-alert)
RESEND_API_KEY=

# Address the contact form delivers to (POST /api/contact)
CONTACT_EMAIL=

# ─── Newsroom (added with the full-coverage newsroom step) ─────────────────

# Editorial passkey. The newsroom at /editorial sends this on every
# publish-affecting request. If unset, the server falls back to "digest2026".
# Set a real value in BOTH .env.local and the Vercel project.
EDITORIAL_PASSKEY=

# Shared secret for the automated discovery cron (/api/cron/ingest).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# If unset the cron endpoint only accepts newsroom requests.
CRON_SECRET=

# Optional: how old a discovered story may be before it is discarded.
# Defaults to 96 hours (4 days).
INGEST_MAX_AGE_HOURS=96
