# ─── The Sports Digest · environment template ───────────────────────────────
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# Live scores from API-Sports. API_SPORTS_KEY is the single shared key and wins
# over the sport-specific variables below, so rotating it swaps every API-Sports
# product in one step. The per-sport variables are read only when the shared key
# is empty; leave them blank unless one product is billed to a separate account.
# Keep every key server-side.
API_SPORTS_KEY=
API_BASKETBALL_KEY=
API_BASEBALL_KEY=
API_NBA_KEY=
API_NFL_KEY=
API_VOLLEYBALL_KEY=
API_HANDBALL_KEY=

# Football provider switch. Setting SPORTMONKS_API_TOKEN makes /api/matches
# serve football data from Sportmonks (app/components/lib/sportmonksFootball.ts)
# and stops calling API-Sports for football entirely. Remove the token to roll
# back to API-Sports. Get the token from MySportmonks → API → API Access, and
# check the subscription covers all featured leagues (Ghana Premier League
# needs the Worldwide plan).
SPORTMONKS_API_TOKEN=

# Ghana Premier League supplement. The GPL is not in the current Sportmonks
# subscription, so /api/matches merges it in from TheSportsDB (free league id
# 4974). Without a key the public test key "123" is used — it works but
# truncates fixture lists and standings. Register a free key at
# thesportsdb.com → API to get the full GPL schedule and table.
THESPORTSDB_API_KEY=

# OpenAI key for editorial insight generation (GET /api/insights)
OPENAI_API_KEY=

# Resend key for the breaking-news bulletin (POST /api/newsletter/breaking-alert)
RESEND_API_KEY=

# Verified sending address for the bulletin, e.g.
# "The Sports Digest <bulletin@thesportsdigest.com>". While this is unset the
# dispatch falls back to Resend's testing sender (onboarding@resend.dev), which
# Resend only permits to deliver to the account owner's own inbox — real
# subscribers are rejected with "Invalid 'to' field". Verify thesportsdigest.com
# at resend.com/domains, then set this in .env.local AND on Vercel.
RESEND_FROM_EMAIL=

# Optional: attach every newsletter signup to a Resend Segment (formerly
# Audience) for broadcast tooling. Signups are ALWAYS mirrored into Resend
# Contacts with just RESEND_API_KEY — the segment is a bonus, not a
# requirement. Find the id in resend.com → Segments → your list.
RESEND_SEGMENT_ID=

# Address the contact form delivers to (POST /api/contact)
CONTACT_EMAIL=

# ─── Newsroom (added with the full-coverage newsroom step) ─────────────────

# Editorial passkey. The newsroom at /editorial sends this on every
# publish-affecting request. If unset, the server falls back to "digest2026".
# Set a real value in BOTH .env.local and the Vercel project.
EDITORIAL_PASSKEY=

# Shared secret for the automated discovery cron (/api/cron/ingest).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# If unset the cron endpoint only accepts newsroom requests.
CRON_SECRET=

# Optional: how old a discovered story may be before it is discarded.
# Defaults to 96 hours (4 days).
INGEST_MAX_AGE_HOURS=96
